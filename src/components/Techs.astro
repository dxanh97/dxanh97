---
import { Icon } from 'astro-icon/components';

import Section from '@/components/Section.astro';

interface Props {
  techList: Array<{ name: string; icon: string }>;
}

const { techList } = Astro.props;
---

<Section header="Tech">
  {techList.map((tech) => (
    <div class="tag">
      <div>
        <Icon name={tech.icon} width="1em" height="1em" aria-hidden="true" />
        <span>{tech.name}</span>
      </div>
    </div>
  ))}
</Section>

<style lang="scss">
  div.tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid var(--color-primary);
    margin-right: 8px;
    margin-bottom: 8px;
    @media (hover: hover) {
      &:hover {
        background: var(--color-primary);
        color: var(--color-background);
      }
      @media (prefers-reduced-motion: no-preference) {
        transition:
          background-color 150ms,
          color 150ms;
      }
    }
    & > div {
      display: flex;
      align-items: center;
      svg {
        margin-right: 4px;
        font-size: 16px;
      }
    }
  }
</style>
