<div class="cursor-wrapper" aria-hidden="true">
  <div class="cursor" data-cursor="ring">
    <span></span>
  </div>
  <div class="cursor" data-cursor="dot">
    <span></span>
  </div>
</div>

<script>
  const $wrapper = document.querySelector<HTMLDivElement>('.cursor-wrapper');

  if (
    $wrapper &&
    !$wrapper.dataset.ready &&
    matchMedia('(pointer: fine)').matches
  ) {
    $wrapper.dataset.ready = '';
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    // Time constants (seconds): the ring trails, the dot nearly tracks.
    // Both are centred on the pointer by their CSS, so no offsets.
    const cursors = [
      { tau: 0.15, dx: 0, dy: 0, x: 0, y: 0 },
      { tau: 0.033, dx: 0, dy: 0, x: 0, y: 0 },
    ].map((c, i) => ({
      ...c,
      el: $wrapper.children[i] as HTMLDivElement,
    }));

    let pointerX = 0;
    let pointerY = 0;
    let frame = 0;
    let last = 0;

    const render = () => {
      for (const c of cursors) {
        c.el.style.transform = `translate3d(${c.x}px,${c.y}px,0)`;
      }
    };

    const snap = () => {
      for (const c of cursors) {
        c.x = pointerX + c.dx;
        c.y = pointerY + c.dy;
      }
      render();
    };

    const tick = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      let settled = true;
      for (const c of cursors) {
        const k = 1 - Math.exp(-dt / c.tau);
        const tx = pointerX + c.dx;
        const ty = pointerY + c.dy;
        c.x += (tx - c.x) * k;
        c.y += (ty - c.y) * k;
        if (Math.abs(tx - c.x) < 0.1 && Math.abs(ty - c.y) < 0.1) {
          c.x = tx;
          c.y = ty;
        } else {
          settled = false;
        }
      }
      render();
      frame = settled ? 0 : requestAnimationFrame(tick);
    };

    document.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      pointerX = e.clientX;
      pointerY = e.clientY;
      if (!$wrapper.classList.contains('is-visible')) {
        if (!$wrapper.dataset.moved) {
          $wrapper.dataset.moved = '';
          snap();
        }
        $wrapper.classList.add('is-visible');
      }
      if (reduceMotion.matches) {
        snap();
      } else if (!frame) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      }
    });

    document.documentElement.addEventListener('mouseleave', () => {
      $wrapper.classList.remove('is-visible', 'is-hovering');
    });

    const onHover = (e: PointerEvent) => {
      const target = e.type === 'pointerover' ? e.target : e.relatedTarget;
      $wrapper.classList.toggle(
        'is-hovering',
        target instanceof Element && !!target.closest('a, button'),
      );
    };
    document.addEventListener('pointerover', onHover);
    document.addEventListener('pointerout', onHover);
  }
</script>

<style lang="scss">
  .cursor-wrapper {
    pointer-events: none;
  }
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    opacity: 0;
    will-change: transform;
    .is-visible & {
      opacity: 1;
    }
    span {
      display: block;
      border-radius: 50%;
    }
  }
  [data-cursor='ring'] span {
    width: 17px;
    height: 17px;
    margin: -8.5px 0 0 -8.5px;
    border: 1.5px solid var(--accent);
    transition:
      transform 0.25s ease,
      background-color 0.25s ease;
  }
  [data-cursor='dot'] span {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--accent);
  }
  .is-hovering [data-cursor='ring'] span {
    transform: scale(2);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-cursor='ring'] span {
      transition: none;
    }
  }
</style>
