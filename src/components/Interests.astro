---
import { Icon } from 'astro-icon/components';

import Prompt from '@/components/Prompt.astro';

interface Props {
  interestList: Array<{ name: string; icon: string }>;
}

const { interestList } = Astro.props;
---

<section class="block">
  <Prompt command="ls ./interests" label="Interests" />
  <ul class="ls">
    {interestList.map((interest) => (
      <li>
        <Icon
          name={interest.icon}
          width="1em"
          height="1em"
          aria-hidden="true"
        />
        {interest.name}
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
  .block {
    margin-bottom: 36px;
  }
  .ls {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    li {
      display: flex;
      align-items: center;
      gap: 10px;
      text-transform: lowercase;
    }
    svg {
      flex: none;
      color: var(--accent);
    }
  }
</style>
