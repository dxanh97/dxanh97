---
import { Icon } from 'astro-icon/components';
---

<button type="button" class="theme-toggle" aria-label="Switch theme">
  <Icon
    name="tabler:moon"
    class="to-dark"
    width="1em"
    height="1em"
    aria-hidden="true"
  />
  <Icon
    name="tabler:sun"
    class="to-light"
    width="1em"
    height="1em"
    aria-hidden="true"
  />
</button>

<script>
  import { themeColors } from '@/data/theme';

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');

  const current = () =>
    root.dataset.theme ??
    (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  const label = () => {
    button?.setAttribute(
      'aria-label',
      current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
  };

  label();
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);

  const apply = (next: 'light' | 'dark') => {
    root.dataset.theme = next;
    try {
      localStorage.theme = next;
    } catch {
      // storage unavailable; the choice just won't persist
    }
    document
      .querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')
      .forEach((meta) => (meta.content = themeColors[next]));
    label();
  };

  button?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    if (
      !document.startViewTransition ||
      matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      apply(next);
      return;
    }
    // Reveal the new theme in a circle growing from the button until it
    // reaches the farthest corner of the viewport.
    const rect = button.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(
      Math.max(x, innerWidth - x),
      Math.max(y, innerHeight - y),
    );
    document
      .startViewTransition(() => apply(next))
      .ready.then(() => {
        root.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${radius}px at ${x}px ${y}px)`,
            ],
          },
          {
            duration: 500,
            easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
            pseudoElement: '::view-transition-new(root)',
          },
        );
      });
  });
</script>

<style lang="scss">
  .theme-toggle {
    /* Above .wrap, which comes later in the page and would cover it. */
    position: absolute;
    z-index: 1;
    top: 16px;
    right: 16px;
    display: inline-flex;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    color: var(--muted);
    font: inherit;
    font-size: var(--text-sm);
    &:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    @media print {
      display: none;
    }
  }
  /* Show the theme the button switches to. */
  .to-light {
    display: none;
  }
  @mixin dark-labels {
    .to-dark {
      display: none;
    }
    .to-light {
      display: block;
    }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) {
      @include dark-labels;
    }
  }
  :global(:root[data-theme='dark']) {
    @include dark-labels;
  }
  /* The click handler animates the new snapshot itself; drop the default
     crossfade so the old theme stays put underneath. */
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>
