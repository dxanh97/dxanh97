---
import { getCollection, render } from 'astro:content';

import Section from '@/components/Section.astro';

const fmt = new Intl.DateTimeFormat('en', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const formatMonth = (ym: string) => fmt.format(new Date(`${ym}-01T00:00:00Z`));

const experiences = (await getCollection('experiences')).sort((a, b) =>
  b.data.start.localeCompare(a.data.start),
);
const experienceList = await Promise.all(
  experiences.map(async (experience) => ({
    ...experience.data,
    Content: (await render(experience)).Content,
  })),
);
---

<Section header="Experiences">
  {experienceList.map((experience) => {
    const { role, start, end, company, companyUrl, Content } = experience;
    return (
      <div class="wrapper">
        <p class="company-role">
          <b>{role}</b>&nbsp;at&nbsp;
          <b>
            <a href={companyUrl} target="_blank" rel="noreferrer">
              {company}
            </a>
          </b>
        </p>
        <span class="period">{`${formatMonth(start)} — ${end ? formatMonth(end) : 'Present'}`}</span>
        <div class="brief">
          <div>
            <Content />
          </div>
        </div>
      </div>
    );
  })}
</Section>

<style lang="scss">
  div.wrapper {
    margin-bottom: 40px;
    p.company-role {
      margin-bottom: 8px;
    }
    span.period {
      color: var(--color-caption);
    }
    .brief :global(ul) {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .brief :global(li)::before {
      content: '• ';
    }
  }
</style>
