---
import { getEntry, render } from 'astro:content';
import { Icon } from 'astro-icon/components';

import Prompt from '@/components/Prompt.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing src/content/profile.mdx');
const { name, role, email, github, linkedin, careerStart } = profile.data;
const { Content } = await render(profile);

const contactList = [
  {
    href: `mailto:${email}`,
    icon: 'feather:mail',
    label: 'Email',
    external: false,
  },
  { href: github, icon: 'feather:github', label: 'GitHub', external: true },
  {
    href: linkedin,
    icon: 'feather:linkedin',
    label: 'LinkedIn',
    external: true,
  },
];

const printContact = [
  email,
  ...[github, linkedin].map((url) => url.replace(/^https?:\/\/(www\.)?/, '')),
].join(' · ');
---

<p class="prompt" aria-hidden="true">
  <span class="tilde">~</span> $ whoami
</p>
<h1 class="name">
  {name}
</h1>
<p class="role">
  <span aria-hidden="true"># </span>
  {role}
</p>
<nav class="links" aria-label="Contact">
  {contactList.map((contact) => (
    <a
      href={contact.href}
      target={contact.external ? '_blank' : undefined}
      rel={contact.external ? 'noreferrer' : undefined}
    >
      <Icon name={contact.icon} width="1em" height="1em" aria-hidden="true" />
      {contact.label}
    </a>
  ))}
</nav>
<p class="print-contact">{printContact}</p>
<section class="block">
  <Prompt command="cat about.txt" label="About" />
  <div class="intro">
    <Content yearsOfExperience={new Date().getFullYear() - careerStart} />
  </div>
</section>

<style lang="scss">
  .name {
    margin: 0 0 16px;
    font-size: 40px;
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: lowercase;
    @media (max-width: 900px) {
      font-size: 52px;
    }
  }
  .role {
    margin: 0 0 22px;
    color: var(--muted);
    text-transform: lowercase;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
    a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      border: 1px solid var(--line);
      border-radius: 6px;
      font-size: 13px;
      text-decoration: none;
      text-transform: lowercase;
      &:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
    }
  }
  .print-contact {
    display: none;
  }
  .block {
    margin-bottom: 36px;
  }
  .intro :global(p) {
    margin: 0;
  }
  .intro :global(strong) {
    color: var(--accent);
    font-weight: 700;
  }
</style>
