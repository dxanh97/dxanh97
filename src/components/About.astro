---
import { getEntry, render } from 'astro:content';
import { Icon } from 'astro-icon/components';

import Section from '@/components/Section.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing src/content/profile.mdx');
const { name, role, email, github, linkedin, careerStart } = profile.data;
const { Content } = await render(profile);

const contactList = [
  { href: `mailto:${email}`, icon: 'feather:mail', label: 'Email', external: false },
  { href: github, icon: 'feather:github', label: 'GitHub', external: true },
  { href: linkedin, icon: 'feather:linkedin', label: 'LinkedIn', external: true },
];
---

<div class="wrapper">
  <div class="box">
    <div class="content">
      <h1 class="name">
        {name.split(' ').map((x) => <Fragment>{x}<br /></Fragment>)}
      </h1>
      <div class="title"><span>{role}</span></div>
      <div class="contact-wrapper">
        {
          contactList.map((contact) => (
            <a href={contact.href} aria-label={contact.label} target={contact.external ? '_blank' : undefined} rel={contact.external ? 'noreferrer' : undefined}><Icon name={contact.icon} width="1em" height="1em" aria-hidden="true" /></a>
          ))
        }
      </div>
    </div>
  </div>
</div>
<Section header="About">
  <div><Content yearsOfExperience={new Date().getFullYear() - careerStart} /></div>
</Section>

<style lang="scss">
  div.wrapper {
    display: flex;
    div.box {
      padding: 10px;
      padding-left: 4px;
      border: 4px solid var(--color-primary);
      overflow: visible;
      position: relative;
      &::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        border-top: 52px solid var(--color-primary);
        border-left: 52px solid transparent;
        width: 0;
      }
      div.content {
        margin-left: -14px;
        padding: 4px;
        padding-right: 0;
        background: var(--color-background);
        &::before {
          content: '';
          position: absolute;
          top: -4px;
          right: -4px;
          border-top: 54px solid var(--color-background);
          border-left: 54px solid transparent;
          width: 0;
          z-index: 2;
        }
        h1.name {
          text-transform: lowercase;
          font-size: 80px;
          line-height: 68px;
          font-weight: 300;
          margin: 4px 0 12px;
        }
        div.title {
          margin-left: -16px;
          margin-bottom: 16px;
          text-transform: uppercase;
          span {
            padding: 4px 20px;
            letter-spacing: 2px;
            background: var(--color-primary);
            color: var(--color-background);
          }
        }
        div.contact-wrapper {
          margin-bottom: 4px;
          a {
            margin-right: 24px;
            font-size: 24px;
            svg {
              vertical-align: bottom;
            }
          }
        }
      }
    }
  }
</style>
