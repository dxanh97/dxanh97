---
import BaseLayout from '@/layouts/BaseLayout.astro';
import About from '@/components/About.astro';
import Experiences from '@/components/Experiences.astro';
import Interests from '@/components/Interests.astro';
import Techs from '@/components/Techs.astro';
import interests from '@/data/interests';
import techs from '@/data/techs';

const command = 'curl https://dxanh97.dev';
---

<BaseLayout>
  <main class="wrap" data-stream>
    <p class="prompt command" data-clear aria-hidden="true">
      <span class="tilde">~</span> $ <span data-type>{command}</span>
    </p>
    <div class="sidebar">
      <About />
      <Techs techList={techs} />
      <div class="interests">
        <Interests interestList={interests} />
      </div>
    </div>
    <div class="career">
      <Experiences />
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  .wrap {
    --pad-y: 64px;
    --pad-x: 40px;
    position: relative;
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 72px;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--pad-y) var(--pad-x);
    @media (max-width: 900px) {
      --pad-y: 40px;
      --pad-x: 20px;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
  /* Sticky only where the whole column fits on screen; otherwise its
     bottom would stay hidden until the page ends. */
  .sidebar {
    align-self: start;
    @media (min-width: 901px) and (min-height: 1080px) {
      position: sticky;
      top: 48px;
    }
    /* In one column, interests go below the career log. */
    @media (max-width: 900px) {
      display: contents;
    }
  }
  .interests {
    @media (max-width: 900px) {
      order: 1;
    }
  }
  /* Only part of the load animation (Stream.astro), which clears it before
     the page streams in. It sits on the first line, out of the flow, so
     clearing it shifts nothing. */
  .command {
    display: none;
    position: absolute;
    top: var(--pad-y);
    left: var(--pad-x);
    margin: 0;
    :global(:root[data-boot]) & {
      display: block;
    }
  }
  .career {
    min-width: 0;
    @media (max-width: 900px) {
      margin-top: 16px;
    }
  }
</style>
