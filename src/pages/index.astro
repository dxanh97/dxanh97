---
import BaseLayout from '@/layouts/BaseLayout.astro';
import About from '@/components/About.astro';
import Experiences from '@/components/Experiences.astro';
import Interests from '@/components/Interests.astro';
import Techs from '@/components/Techs.astro';
import interests from '@/data/interests';
import techs from '@/data/techs';
---

<BaseLayout>
  <main class="wrapper">
    <div class="about"><About /></div>
    <div class="techs"><Techs techList={techs} /></div>
    <div class="experiences"><Experiences /></div>
    <div class="interests"><Interests interestList={interests} /></div>
  </main>
</BaseLayout>

<style lang="scss">
  /* Grid items don't collapse margins like the old flex columns did, so the
     paragraph-to-heading gaps are compensated below. */
  main.wrapper {
    margin: auto;
    padding-top: 100px;
    padding-bottom: 100px;
    display: grid;
    grid-template-columns: calc(40% + 32px) 1fr;
    grid-template-rows: auto auto 1fr;
    grid-template-areas:
      'about experiences'
      'techs experiences'
      'interests experiences';
    @media (min-width: 1000px) {
      max-width: 1000px;
    }
    @media (max-width: 600px) {
      grid-template-columns: 100%;
      grid-template-rows: auto;
      grid-template-areas:
        'about'
        'techs'
        'experiences'
        'interests';
    }
    & > div {
      padding: 0 16px;
      min-width: 0;
      @media (max-width: 600px) {
        box-sizing: border-box;
        padding: 0 20px;
      }
    }
    & > div.about {
      grid-area: about;
    }
    & > div.techs {
      grid-area: techs;
      margin-top: -20px;
    }
    & > div.experiences {
      grid-area: experiences;
    }
    & > div.interests {
      grid-area: interests;
      @media (max-width: 600px) {
        margin-top: -40px;
      }
    }
  }
</style>
