---
import BaseLayout from '@/layouts/BaseLayout.astro';
import About from '@/components/About.astro';
import Experiences from '@/components/Experiences.astro';
import Interests from '@/components/Interests.astro';
import Techs from '@/components/Techs.astro';
import interests from '@/data/interests';
import techs from '@/data/techs';
---

<BaseLayout>
  <div class="wrap">
    <aside>
      <About />
      <Techs techList={techs} />
      <Interests interestList={interests} />
    </aside>
    <main>
      <Experiences />
    </main>
  </div>
</BaseLayout>

<style lang="scss">
  .wrap {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 72px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 40px;
    @media (max-width: 900px) {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding: 40px 20px;
    }
  }
  /* Sticky only where the whole column fits on screen; otherwise its
     bottom would stay hidden until the page ends. */
  aside {
    align-self: start;
    @media (min-width: 901px) and (min-height: 1080px) {
      position: sticky;
      top: 48px;
    }
  }
  main {
    min-width: 0;
  }
</style>
