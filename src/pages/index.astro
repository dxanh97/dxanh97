---
import BaseLayout from '@/layouts/BaseLayout.astro';
import About from '@/components/About.astro';
import Experiences from '@/components/Experiences.astro';
import Interests from '@/components/Interests.astro';
import Techs from '@/components/Techs.astro';
import interests from '@/data/interests';
import techs from '@/data/techs';
---

<BaseLayout>
  <main class="wrapper">
    <div class="information-wrapper">
      <div>
        <About />
        <Techs techList={techs} />
        <div class="desktop">
          <Interests interestList={interests} />
        </div>
      </div>
      <div>
        <Experiences />
        <div class="mobile">
          <Interests interestList={interests} />
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  main.wrapper {
    margin: auto;
    padding-top: 100px;
    padding-bottom: 100px;
    @media (min-width: 1000px) {
      max-width: 1000px;
    }
    div.information-wrapper {
      display: flex;
      @media (max-width: 600px) {
        flex-direction: column;
      }
      & > div:first-child {
        width: 40%;
        padding: 0 16px;
        @media (max-width: 600px) {
          width: 100%;
          box-sizing: border-box;
          padding: 0 20px;
        }
        & > div.desktop {
          @media (max-width: 600px) {
            display: none;
          }
        }
      }
      & > div:last-child {
        flex: 1;
        padding: 0 16px;
        @media (max-width: 600px) {
          flex: unset;
          width: 100%;
          box-sizing: border-box;
          padding: 0 20px;
        }
        & > div.mobile {
          display: none;
          @media (max-width: 600px) {
            display: initial;
          }
        }
      }
    }
  }
</style>
