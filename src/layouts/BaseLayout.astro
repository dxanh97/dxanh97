---
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.scss';
import '@/styles/print.scss';
import Cursor from '@/components/Cursor.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import latin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import latinExt from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2?url';
import vietnamese from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-vietnamese-wght-normal.woff2?url';

const title = '<dxanh97 />';
const description =
  'Software Engineer specializing in JavaScript and TypeScript.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />
    {[latin, latinExt, vietnamese].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <script is:inline>
      try {
        const theme = localStorage.theme;
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          const color = theme === 'dark' ? '#0a0a0a' : '#fafafa';
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach(function (meta) {
              meta.content = color;
            });
        }
      } catch {
        // storage unavailable; follow the system theme
      }
    </script>
  </head>
  <body>
    <Cursor />
    <ThemeToggle />
    <slot />
  </body>
</html>
