---
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '@/styles/global.scss';
import '@/styles/print.scss';
import Cursor from '@/components/Cursor.astro';
import Stream from '@/components/Stream.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { getEntry } from 'astro:content';
import { themeColors } from '@/data/theme';
// Body text is 400 latin. The name is bold and needs all three bold
// subsets (Đ is latin-ext, ặ is Vietnamese), which would otherwise be found
// only after styles are computed.
import latin400 from '@fontsource/space-mono/files/space-mono-latin-400-normal.woff2?url';
import latin700 from '@fontsource/space-mono/files/space-mono-latin-700-normal.woff2?url';
import latinExt700 from '@fontsource/space-mono/files/space-mono-latin-ext-700-normal.woff2?url';
import vietnamese700 from '@fontsource/space-mono/files/space-mono-vietnamese-700-normal.woff2?url';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing src/content/profile.mdx');
const { name, role, github, linkedin } = profile.data;

const title = `${name} · ${role}`;
const description =
  'Software Engineer specializing in JavaScript and TypeScript.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  jobTitle: role,
  url: Astro.site?.href,
  sameAs: [github, linkedin],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="theme-color"
      content={themeColors.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColors.dark}
      media="(prefers-color-scheme: dark)"
    />
    {[latin400, latin700, latinExt700, vietnamese700].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline define:vars={{ themeColors }}>
      try {
        const theme = localStorage.theme;
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          const color = themeColors[theme];
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach(function (meta) {
              meta.content = color;
            });
        }
      } catch {
        // storage unavailable; follow the system theme
      }
    </script>
    <script is:inline>
      // Hide the page until Stream.astro prints it. Only once per tab
      // session, never with reduced motion or for automated audits (which
      // would measure text mid-fade), and show everything if the stream has
      // not started in 3s. `?stream` forces it, so tests can exercise it.
      let seen = false;
      try {
        seen = sessionStorage.streamed === '1';
      } catch {
        // storage unavailable; always stream
      }
      const forced = new URLSearchParams(location.search).has('stream');
      if (
        forced ||
        (!seen &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches &&
          !navigator.webdriver)
      ) {
        const root = document.documentElement;
        root.dataset.boot = '';
        setTimeout(function () {
          if (root.dataset.boot === '') delete root.dataset.boot;
        }, 3000);
      }
    </script>
  </head>
  <body>
    <Cursor />
    <ThemeToggle />
    <slot />
    <Stream />
  </body>
</html>
